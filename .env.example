# Agente LO QUIERO. En el VPS estos van en el .env del agente (o /opt/data/.env).
# Nunca commitear el .env real.

# --- Kapso (WhatsApp) ---
KAPSO_API_KEY=                 # el mismo que usa el ops center para enviar
KAPSO_WEBHOOK_SECRET=          # de Kapso, firma los webhooks de entrada (HMAC-SHA256)
KAPSO_PHONE_NUMBER_ID=         # phone-number-id del numero de WhatsApp de LO QUIERO
# Puerto propio del gateway (distinto al de Rumpel/HorseGo para no chocar)
KAPSO_PORT=8649
KAPSO_WEBHOOK_PATH=/kapso/webhook

# --- Supabase (ops center de LO QUIERO) ---
LOQUIERO_SUPABASE_URL=          # https://<project-ref>.supabase.co
LOQUIERO_SUPABASE_SERVICE_ROLE_KEY=   # service role (server-only, bypassa RLS)

# --- Motor (OpenAI-compatible, GPT) ---
OPENAI_API_KEY=
LOQUIERO_MODEL=                 # el modelo con tool-calling que elijas
